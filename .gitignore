# Virtualenv — 16MB, 1082 files, recreate with: pip install -r requirements.txt
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ARIA runtime state — the graph and working state are per-machine, never shared.
# The graph is the only persistent memory; committing it would leak the user's
# actual conversation history and emotional state.
aria_state.json
self_model.json
*.db
*.sqlite
*.sqlite3

# macOS
.DS_Store
